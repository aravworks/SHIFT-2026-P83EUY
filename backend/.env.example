# Edge Function secrets (set with `supabase secrets set --env-file backend/.env`)
# Demo-grade shared HMAC key. Generate with: openssl rand -hex 16
GROUP_KEY=change-me

# How long a station holds a battery for a vehicle, in minutes. Required by POST /vehicle/v1/reservations.
# Deliberately unset: choose it with the station operators.
HOLD_MINUTES=
