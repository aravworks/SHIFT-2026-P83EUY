# Vite ONLY exposes variables that start with VITE_. Anything else here is ignored (on purpose).
# These two are public by design; never put the service-role key or GROUP_KEY in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: use the Render API service instead of Supabase Edge Functions
# VITE_API_URL=https://your-service.onrender.com
